# Butterfly Agent — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Required ────────────────────────────────────────────────────────────

# Your LLM API key (OpenAI, Anthropic, or any OpenAI-compatible API).
LLM_API_KEY=sk-your-api-key-here

# ── LLM Provider ────────────────────────────────────────────────────────

# Base URL for the LLM API endpoint. Only set if using a custom/proxy endpoint.
# LLM_BASE_URL=https://api.openai.com/v1

# ── Model Selection ─────────────────────────────────────────────────────

# Default model in provider/model format (e.g., "anthropic/claude-sonnet-4-5").
# BUTTERFLY_MODEL=anthropic/claude-sonnet-4-5

# Tier-specific model overrides (only set if you want different models per tier).
# BUTTERFLY_MODEL_TRIVIAL=anthropic/claude-haiku-4-5
# BUTTERFLY_MODEL_STANDARD=anthropic/claude-sonnet-4-5
# BUTTERFLY_MODEL_COMPLEX=anthropic/claude-sonnet-4-5
# BUTTERFLY_MODEL_ESCALATE=anthropic/claude-opus-4-1

# ── Agent Behavior ──────────────────────────────────────────────────────

# Log level: debug, info, warn, error (default: info).
# AGENT_LOG_LEVEL=info

# Maximum agent loop iterations (default: 20).
# AGENT_MAX_STEPS=20

# ── Debug & Tracing ─────────────────────────────────────────────────────

# Enable debug output.
# DEBUG=false

# Debug namespace filter (default: butterfly:*).
# DEBUG_NAMESPACE=butterfly:*

# Enable OpenTelemetry tracing.
# TRACE_ENABLED=false

# Trace exporter: console, otlp, or zipkin (default: console).
# TRACE_EXPORTER=console

# ── ACP (Agent Client Protocol) ──────────────────────────────────────────

# Enable streaming via sessionUpdate (true/false, default: true).
# ACP_STREAM=true

# ── Server ───────────────────────────────────────────────────────────────

# Port to listen on (default: 3000).
# PORT=3000

# ── Server Authentication ─────────────────────────────────────────────────

# API key for HTTP + ACP authentication. When set, all API requests must
# include "Authorization: Bearer <key>". Multiple keys can be comma-separated.
# Leave unset to allow all requests (no auth).
# BUTTERFLY_API_KEY=

# Custom header name for API key auth (default: Authorization).
# BUTTERFLY_AUTH_HEADER=Authorization

# Working directory for the agent (default: process.cwd()).
# BUTTERFLY_CWD=/path/to/project

# Session persistence backend: fs (default) or sqlite.
# BUTTERFLY_SESSION_STORE=fs
#
# NOTE: Sessions are NEVER auto-deleted by default. To enable stale-session
# cleanup, set "butterfly.backgroundJobs.staleSessionAgeMs" in .butterfly/config.json
# (e.g. 7 days = 604800000). There is intentionally no env-var toggle — opt-in
# only, to prevent silent data loss.

# LSP integration — enabled by default. Set BUTTERFLY_LSP=0 to disable.
# BUTTERFLY_LSP=1
# BUTTERFLY_LSP_COMMAND=npx --yes typescript-language-server@4.3.3 --stdio
