# LLM Provider
LLM_API_KEY=
LLM_BASE_URL=

# Model Router per tier (override only the ones you need).
# Defaults target Anthropic via an OpenAI-compatible gateway: triv=claude-haiku-4-5,
# std=claude-sonnet-4-5, cplx=claude-sonnet-4-5, esc=claude-opus-4-1.
# If your LLM_BASE_URL points to a different provider (Mistral, OpenAI, self-hosted, etc.),
# override the tiers with models that provider actually serves — e.g. for Mistral:
#   BUTTERFLY_MODEL_TRIVIAL=mistral-small-latest
#   BUTTERFLY_MODEL_STANDARD=mistral-medium-latest
#   BUTTERFLY_MODEL_COMPLEX=mistral-large-latest
#   BUTTERFLY_MODEL_ESCALATE=mistral-large-latest
# BUTTERFLY_MODEL_TRIVIAL=
# BUTTERFLY_MODEL_STANDARD=
# BUTTERFLY_MODEL_COMPLEX=
# BUTTERFLY_MODEL_ESCALATE=

# Agent Configuration
AGENT_LOG_LEVEL=info
AGENT_MAX_STEPS=10

# Debug
DEBUG=false
DEBUG_NAMESPACE=butterfly:*

# Tracing
TRACE_ENABLED=false
TRACE_EXPORTER=console
