# ─── Butterfly Agent Environment Variables ────────────────────────────────────
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Required:
#   LLM_API_KEY — your OpenAI-compatible API key
#
# Optional overrides:
#   LLM_BASE_URL    — base URL for the LLM API (defaults to OpenAI)
#   AGENT_LOG_LEVEL — log level: debug, info, warn, error (default: info)
#   AGENT_MAX_STEPS — max agent loop iterations (default: 20)
#   PORT            — HTTP server port (default: 3000)
#
# Model tier overrides:
#   BUTTERFLY_MODEL              — default model (default: anthropic/claude-sonnet-4-5)
#   BUTTERFLY_MODEL_TRIVIAL     — trivial tasks (default: tier default)
#   BUTTERFLY_MODEL_STANDARD    — standard tasks (default: tier default)
#   BUTTERFLY_MODEL_COMPLEX     — complex tasks (default: tier default)
#   BUTTERFLY_MODEL_ESCALATE    — escalate tier (default: tier default)
#
# Debug & tracing:
#   DEBUG           — enable debug output (true/false, default: false)
#   DEBUG_NAMESPACE — debug namespace filter (default: butterfly:*)
#   TRACE_ENABLED   — enable OpenTelemetry tracing (true/false, default: false)
#   TRACE_EXPORTER  — trace exporter: console, otlp, zipkin (default: console)
#
# ACP (Agent Client Protocol):
#   ACP_STREAM — enable streaming via sessionUpdate (true/false, default: true)

# Required: set your LLM API key
LLM_API_KEY=

# Optional: base URL for the LLM API (omit for OpenAI default)
# LLM_BASE_URL=https://api.openai.com/v1

# Optional: logging
# AGENT_LOG_LEVEL=info
# AGENT_MAX_STEPS=20

# Optional: model overrides
# BUTTERFLY_MODEL=anthropic/claude-sonnet-4-5
