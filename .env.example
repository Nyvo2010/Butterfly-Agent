# LLM API key (required). Supports any OpenAI-compatible API.
LLM_API_KEY=

# LLM base URL. Default uses OpenAI. Set to any OpenAI-compatible endpoint.
# LLM_BASE_URL=

# Agent log level: debug | info | warn | error (default: info)
# AGENT_LOG_LEVEL=info

# Max agent loop steps (default: 10)
# AGENT_MAX_STEPS=10

# Default model override (provider/model format, e.g., "anthropic/claude-sonnet-4-5")
# BUTTERFLY_MODEL=anthropic/claude-sonnet-4-5

# Per-tier model overrides
# BUTTERFLY_MODEL_TRIVIAL=
# BUTTERFLY_MODEL_STANDARD=
# BUTTERFLY_MODEL_COMPLEX=
# BUTTERFLY_MODEL_ESCALATE=

# Enable debug output
# DEBUG=false
# DEBUG_NAMESPACE=butterfly:*

# Enable OpenTelemetry tracing
# TRACE_ENABLED=false
# TRACE_EXPORTER=console
